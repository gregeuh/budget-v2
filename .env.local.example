# --- Firebase (repris de ton projet existant : Console Firebase > Paramètres du projet > Tes applications) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Ces routes ne fonctionnent qu'avec un utilisateur Firebase connecté. Ne jamais y placer
# une clé secrète : la vérification du jeton se fait via Firebase Identity Toolkit.

# --- Coach IA (clé API Anthropic, côté serveur uniquement, jamais exposée au navigateur) ---
ANTHROPIC_API_KEY=
## Powens Sandbox (ne jamais préfixer ces variables par NEXT_PUBLIC_)
POWENS_DOMAIN=your-domain-sandbox.biapi.pro
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
